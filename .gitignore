# FlyWire data is CC BY-NC 4.0 — never vendor it into git.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# belt and braces: connectome exports anywhere in the tree
*.csv
*.csv.gz
*.crdownload
*.feather
*.zip
sk_lod1_*

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

logs/
runs/
*.mp4
# ...but the demo clip is a deliverable, not an artifact
!media/flydoom.mp4

# downloaded reference papers -- not our own output
full.html
*.pdf
full_files/
# ...the preprint and its figures ARE deliverables
!paper/main.pdf
!paper/figs/*.pdf

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/figs/*.png
texput.log
